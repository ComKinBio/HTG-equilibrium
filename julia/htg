#!/bin/sh
# htg: the HTG equilibrium command line, Julia version (Linux and macOS).
#
#     julia/htg check cases/manure_gas_min.toml
#     julia/htg run cases/manure_gas_min.toml --workers 4
#     julia/htg gui
#
# Runs `julia -m HTGEquilibrium ARGS...` with this repository's package
# (julia/HTGEquilibrium) and one thread per CPU thread, so that `--workers N`
# can use N threads. The command `gui` runs `julia -m HTGApp ARGS...` with the
# app package (julia/HTGApp) instead, so that the other commands do not load
# the GUI packages. JULIA_NUM_THREADS chooses another thread count, JULIA
# another julia executable (default: julia on PATH).
set -e
script=$0
while [ -L "$script" ]; do   # follow links, e.g. ~/bin/htg -> this file
    target=$(readlink "$script")
    case $target in
        /*) script=$target ;;
        *) script=$(dirname -- "$script")/$target ;;
    esac
done
here=$(CDPATH= cd -- "$(dirname -- "$script")" && pwd -P)
# The command is the first word that is not an option of htg itself (-h, --data DIR).
package=HTGEquilibrium
skip=
for arg in "$@"; do
    if [ -n "$skip" ]; then skip=; continue; fi
    case $arg in
        --d|--da|--dat|--data) skip=1 ;;
        -*) ;;
        *) if [ "$arg" = gui ]; then package=HTGApp; fi; break ;;
    esac
done
exec "${JULIA:-julia}" --project="$here/$package" --threads="${JULIA_NUM_THREADS:-auto}" \
    --startup-file=no -m "$package" "$@"
